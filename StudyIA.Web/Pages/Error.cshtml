@page
@model ErrorModel
@{
    ViewData["Title"] = "Error";
}

<div class="tarjeta">
    <h1>Ocurrió un error</h1>
    <p>Algo salió mal al procesar tu solicitud. Intenta de nuevo; si el problema continúa, avisa al equipo.</p>
    @if (!string.IsNullOrEmpty(Model.IdSolicitud))
    {
        <p class="texto-porcentaje">Código de la solicitud: @Model.IdSolicitud</p>
    }
    <a href="/" class="boton">Volver al inicio</a>
</div>
